# =============================================================================
# n8n - Affiliate Automation Stack
# =============================================================================
# Set these in n8n -> Settings -> Variables (or in the n8n container env).
# If your instance has N8N_BLOCK_ENV_ACCESS_IN_NODE=true, use n8n Variables
# and reference them via {{$vars.NAME}} instead of {{$env.NAME}}.
# -----------------------------------------------------------------------------

# -----------------------------------------------------------------------------
# Shared - Claude / Anthropic
# -----------------------------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
CLAUDE_MODEL=claude-opus-4-20250514

# -----------------------------------------------------------------------------
# WF-01  Affiliate Product Processing Pipeline
# -----------------------------------------------------------------------------
# Endpoint that accepts processed product payloads. Until you build a real
# ingest API, point this at a https://webhook.site/... URL to inspect output.
WEBSITE_INSERT_URL=https://your-site.example.com/api/affiliate/ingest
WEBSITE_API_TOKEN=replace-with-bearer-token

# -----------------------------------------------------------------------------
# WF-02  Pinterest Pin Variant Generator
# -----------------------------------------------------------------------------
# Source of truth for products. Use either:
#   - GitHub raw URL:   https://raw.githubusercontent.com/<owner>/<repo>/main/data/products.json
#   - Live site URL:    https://summerfindslab.com/data/products.json    (only if you serve it as static)
PRODUCTS_JSON_URL=https://raw.githubusercontent.com/your-org/summerfindslab-site/main/data/products.json

# Optional - skip products that already have pins. Same format as above.
# If you don't have one yet, leave it pointing at a 404 url; the workflow
# tolerates the failure and treats every product as unpinned.
EXISTING_PINS_JSON_URL=https://raw.githubusercontent.com/your-org/summerfindslab-site/main/data/pinterest-pins.json

# Site origin used to build pin links (no trailing slash needed).
SITE_URL=https://summerfindslab.com

# Endpoint that accepts new pin records. Same notes as WEBSITE_INSERT_URL.
PINS_INGEST_URL=https://your-site.example.com/api/pins/ingest
PINS_INGEST_TOKEN=replace-with-bearer-token

# Optional - override the batch label that gets written to every pin.
# Default: summer-2026-batch-YYMMDD
# PINS_BATCH_ID=summer-2026-batch-01

# Optional - how many pin variants to generate per product (1-10).
# Default: 3. One variant per Canva formula, in the order defined in
# build-pin-generator.js.
FORMULAS_PER_PRODUCT=3

# -----------------------------------------------------------------------------
# WF-03  Canva Materializer (calls the website's existing /api/canva/webhook)
# -----------------------------------------------------------------------------
CANVA_WEBHOOK_URL=https://summerfindslab.com/api/canva/webhook
CANVA_WEBHOOK_SECRET=replace-with-the-same-secret-set-in-the-website-env

# -----------------------------------------------------------------------------
# WF-06  Opportunity Intelligence System
# -----------------------------------------------------------------------------
# Daily 06:00 UTC. Discovers trending Pinterest keywords + Amazon Movers &
# Shakers, scores every product 0-100 on Pinterest potential and affiliate
# potential, asks Claude for an executive brief, and POSTs the daily report
# to /api/opportunities/ingest so tomorrow's run can compute deltas.

# Firecrawl (https://www.firecrawl.dev) — used for trend discovery via /v2/scrape
FIRECRAWL_API_KEY=fc-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Where the workflow POSTs the daily report.
OPPORTUNITY_INGEST_URL=https://summerfindslab.com/api/opportunities/ingest
OPPORTUNITY_INGEST_TOKEN=replace-with-the-same-secret-set-in-the-website-env

# Where the workflow GETs yesterday's report (for day-over-day deltas).
# Either the GET endpoint above, or a raw GitHub URL to data/opportunities/latest.json.
OPPORTUNITY_HISTORY_URL=https://summerfindslab.com/api/opportunities/latest

# Optional - how many products to surface in the daily Top-N (5..50, default 10).
# OPPORTUNITY_TOP_N=10

# -----------------------------------------------------------------------------
# WF-04  Pinterest Publisher
# -----------------------------------------------------------------------------
# Daily 09:00 UTC. Reads data/pinterest-pins.json, skips ids already in
# data/pinterest-published.json, throttles to PINS_PER_RUN per run, and
# publishes each pin to your Pinterest business account via /v5/pins.

# Pinterest API access token. Generate at developers.pinterest.com.
# Required scopes: boards:read pins:read pins:write user_accounts:read.
PINTEREST_ACCESS_TOKEN=pina_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Fallback board id if a pin's boardSuggestion doesn't match any of your boards
# by name. Get the id from /v5/boards (or copy from the URL of any board).
PINTEREST_DEFAULT_BOARD_ID=

# How many pins to publish per run. Keep 5/day for the first 7 days on a
# brand-new account, then ramp to 10/day for weeks 2-3, then 15-20/day.
PINS_PER_RUN=5

# Optional - replace the host on every pin.link before posting.
# Useful if pinterest-pins.json was generated against a staging URL.
# PIN_LINK_OVERRIDE_HOST=https://summerfindslab.com

# Where to read the published log from (GET, public).
PUBLISHED_LOG_URL=https://summerfindslab.com/api/pinterest/published

# Where to append a new published record (POST, bearer-auth'd).
PUBLISHED_INGEST_URL=https://summerfindslab.com/api/pinterest/published
PUBLISHED_INGEST_TOKEN=replace-with-the-same-secret-set-in-the-website-env

# -----------------------------------------------------------------------------
# WF-04b  Pinterest Publish Pin (single-pin webhook)
# -----------------------------------------------------------------------------
# Webhook-triggered single-pin publisher called by the Pin Factory once a
# Canva render is ready. Accepts JSON with imageUrl, title, description,
# link (affiliate URL), boardId, and optional altText/pinId.
# Re-uses PINTEREST_ACCESS_TOKEN, PUBLISHED_INGEST_URL, PUBLISHED_INGEST_TOKEN.

# Shared secret the caller MUST send in the `x-pin-publish-secret` header
# (or the `secret` field of the JSON body). Generate a long random string.
PIN_PUBLISH_WEBHOOK_SECRET=replace-with-a-long-random-secret

# -----------------------------------------------------------------------------
# WF-04c  Pinterest Boards Helper
# -----------------------------------------------------------------------------
# Manual / webhook helper that validates the access token, lists every
# board the token can see (paginated /v5/boards), and persists the result
# so other workflows can read board ids without re-hitting Pinterest.
# Re-uses PINTEREST_ACCESS_TOKEN.

# Optional - where to POST the resolved board list. If unset, the persist
# step is skipped and the diagnostic report is still emitted in-memory.
BOARDS_CACHE_INGEST_URL=https://summerfindslab.com/api/pinterest/boards
BOARDS_CACHE_INGEST_TOKEN=replace-with-the-same-secret-set-in-the-website-env

