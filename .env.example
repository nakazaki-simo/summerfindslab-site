# =============================================================================
# Summer Finds Lab — Environment Variables
# =============================================================================
# Copy this file to `.env.local` (Next.js) and / or `.env` (Node scripts).
# Never commit real secrets. `.env` and `.env.local` are gitignored.
# -----------------------------------------------------------------------------

# -----------------------------------------------------------------------------
# Site
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# Canva Connect API
# -----------------------------------------------------------------------------
# Create a Canva integration here:  https://www.canva.com/developers/integrations
# 1. Create a "Public" integration (or "Private" for personal use).
# 2. Copy Client ID + Client Secret below.
# 3. Set the redirect URL in the Canva dashboard to:
#       <NEXT_PUBLIC_SITE_URL>/api/canva/oauth/callback
# 4. Add the scopes the project needs (see lib/canva/config.js > REQUIRED_SCOPES).
# -----------------------------------------------------------------------------

CANVA_CLIENT_ID=
CANVA_CLIENT_SECRET=
CANVA_REDIRECT_URI=http://localhost:3000/api/canva/oauth/callback

# Where the OAuth tokens are persisted on disk after the first login.
# Default: ./data/canva/tokens.json (gitignored).
CANVA_TOKEN_STORE=./data/canva/tokens.json

# Optional: pin to the Canva API base. Override only if Canva tells you to.
CANVA_API_BASE=https://api.canva.com/rest/v1
CANVA_AUTH_BASE=https://www.canva.com/api/oauth

# -----------------------------------------------------------------------------
# Pin Generation Pipeline
# -----------------------------------------------------------------------------
# How many pins to attempt per batch run. Keeps you under Canva's rate limits.
CANVA_BATCH_SIZE=10
# How long to wait (ms) between Canva API calls in a batch.
CANVA_BATCH_DELAY_MS=400
# Where exported PNG/JPG URLs are written by the generator.
CANVA_EXPORT_LOG=./data/canva/exports.json

# -----------------------------------------------------------------------------
# Webhook (future n8n / scheduling)
# -----------------------------------------------------------------------------
# Shared secret n8n must send in the `x-canva-pipeline-secret` header to
# trigger /api/canva/webhook. Generate a long random string.
CANVA_WEBHOOK_SECRET=

# -----------------------------------------------------------------------------
# WF-06 Opportunity Intelligence ingest endpoint
# -----------------------------------------------------------------------------
# Bearer token that /api/opportunities/ingest expects from n8n.
# Must match OPPORTUNITY_INGEST_TOKEN in the n8n env.
OPPORTUNITY_INGEST_TOKEN=replace-with-a-random-secret
